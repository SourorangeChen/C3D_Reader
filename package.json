{
  "name": "c3d-reader",
  "version": "0.3.3",
  "description": "Local-first C3D motion capture viewer inspired by Mokka",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write frontend/src vite.config.ts tsconfig.json playwright.config.ts tests/viewer.spec.ts",
    "desktop:dev": "electron .",
    "desktop:build": ".venv/bin/python scripts/build_macos.py",
    "test:desktop": "playwright test --config playwright.desktop.config.ts"
  },
  "keywords": [],
  "author": "SourorangeChen",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "main": "desktop/main.cjs"
}
